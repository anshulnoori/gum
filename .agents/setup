#!/usr/bin/env bash
set -euo pipefail

root="$(dirname "$(dirname "$(realpath "$0")")")"

if [[ "$(dpkg-query -W -f='${Status}' openjdk-17-jdk-headless 2>/dev/null || :)" != 'install ok installed' ]]; then
    echo 'Installing JDK 17'
    sudo apt-get update -qq
    sudo apt-get install -y -qq openjdk-17-jdk-headless
fi

echo 'Building and testing the JVM lifecycle module'
"$root/gradlew" -p "$root" --no-daemon :core:test --console=plain
